{
  "name": "myterm-firebase-development-tools",
  "private": true,
  "version": "0.0.0",
  "description": "MyTerm \u672c\u6a5f Firebase Emulator \u8207 Security Rules \u6e2c\u8a66\u5de5\u5177\uff1b\u4e0d\u5c6c\u65bc App \u57f7\u884c\u6642\u76f8\u4f9d\u5957\u4ef6\u3002",
  "type": "module",
  "scripts": {
    "emulators": "./scripts/firebase-tools.sh emulators:start --project demo-myterm --only auth,firestore",
    "test:firestore-rules": "./scripts/firebase-tools.sh emulators:exec --project demo-myterm --only firestore \"node --test Tests/FirebaseRules/firestore.rules.test.mjs\"",
    "deploy:firestore": "./scripts/deploy-firestore.sh",
    "test:development-tools": "./scripts/project-node.sh --test Tests/Security/development-tools.test.cjs Tests/Security/firebase-stream-json.test.cjs Tests/Security/firebase-installation.test.cjs Tests/Security/dependency-advisories.test.cjs Tests/Security/firebase-glob.test.cjs Tests/Security/firebase-removed-dependencies.test.cjs Tests/Security/firebase-http-dependencies.test.cjs Tests/Security/firebase-mcp-sdk.test.cjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "@google-cloud/pubsub": {
      "@opentelemetry/core": "2.11.0"
    },
    "gaxios@6.7.1": {
      "uuid": "11.1.1"
    },
    "qs": "6.16.1",
    "@grpc/grpc-js": "1.14.5",
    "glob": "13.0.6"
  }
}
