  "cases": {
    "validated-ip-input": {
      "consumer": "npm-entry",
      "conclusion": [
        "字串入口先經 net.isIPv6，另一條回應路徑從固定 16 bytes 的 IPv6 轉成字串。既有 Node 24.22.1 原生正規式證據只允許一次 zone 百分號及受限字元，不符合公告的重複百分號／換行前提；呼叫檔與 Node pin 未變。這是限定入口的限制，不是原套件修補。"
      ],
      "sourceFiles": {
        "Config/Security/node-tools.json": "5d85abe92a7025028797628372c284d6885e3feea4a42de5a9627ef77eda79f9",
        "scripts/project-node.sh": "82b730cbb9885ffe8d654a4dc7acd0a89c03db44fd03c6872c2940d7eefa46f2",
        "scripts/firebase-tools.sh": "c9f79f4ec897f8cd0ad88234f574bb3f1681efd8b755f6d8aea9b454f35dd708",
        "scripts/verify-firebase-tools.cjs": "97580ebac29b2c0167c8b68d613ea8b4539ef1ba02166334fb56a29a71d8201e"
      },
      "advisoryConditions": [
        {
          "id": "GHSA-rxp7-6hxx-x8q5",
          "scope": "development",
          "assessment": "字串入口先經 net.isIPv6，另一條回應路徑從固定 16 bytes 的 IPv6 轉成字串。既有 Node 24.22.1 原生正規式證據只允許一次 zone 百分號及受限字元，不符合公告的重複百分號／換行前提；呼叫檔與 Node pin 未變。這是限定入口的限制，不是原套件修補。"
        }
      ]
    },
    "npm-no-eventsource": {
      "consumer": "npm-entry",
      "conclusion": [
        "目前實際引入點沒有 EventSource；公告要求 EventSource 串流解析，與 node-gyp 的下載功能不同。呼叫檔 hash 與既有分析一致；僅限本筆 EventSource 公告，不推論其他 fetch 告警安全。"
      ],
      "sourceFiles": {
